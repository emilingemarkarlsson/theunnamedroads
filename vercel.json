{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "theunnamedroads.com" }],
      "destination": "https://www.theunnamedroads.com/$1",
      "statusCode": 301
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "e.theunnamedroads.com" }],
      "destination": "https://www.theunnamedroads.com/",
      "permanent": true
    }
  ]
}
