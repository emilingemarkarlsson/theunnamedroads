---
import NavItem from '@/components/layout/NavItem.astro'
import StatusChip from '@/components/StatusChip.astro'
import PageLayout from '@/layouts/PageLayout.astro'
import Prose from '@/components/layout/Prose.astro'
import { toMonthString } from '@/util'
import { getStatus } from '@/util/projects'
import { getCollection } from 'astro:content'
import type { InferGetStaticPropsType } from 'astro'

type Props = InferGetStaticPropsType<typeof getStaticPaths>

export async function getStaticPaths() {
  const projects = await getCollection('projects')
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project }
  }))
}

const { project } = Astro.props
const { Content } = await project.render()
const statusLabel = getStatus(project)
const homepage = project.data.homepage
const workingUrl = (homepage?.href ?? project.data.url)?.trim()
const ctaLabel = homepage?.ctaLabel ?? 'Visit the site'
const timelineStart = toMonthString(project.data.startDate)
const timelineEnd = project.data.endDate
  ? toMonthString(project.data.endDate)
  : null
const timeline = timelineEnd
  ? `${timelineStart} – ${timelineEnd}`
  : timelineStart

const faq = project.data.faq

const frontmatter = {
  title: `${project.data.title} (${statusLabel}): an AI-built venture`,
  description: project.data.description,
  activeHeaderLink: 'Projects',
  fullBleed: true,
  project: {
    name: project.data.title,
    description: project.data.description,
    url: workingUrl,
    startDate: project.data.startDate,
    endDate: project.data.endDate,
    statusLabel,
    tags: project.data.tags
  },
  ...(faq?.length && { faq })
}
const contentContainerClass = 'mx-auto w-full max-w-3xl px-3 sm:px-6 lg:px-8'
---

<PageLayout {frontmatter}>
  <div slot="top" class="mt-4">
    <NavItem
      item={{
        label: 'Back to all projects',
        href: '/projects',
        icon: 'tabler--arrow-left'
      }}
    />
  </div>

  <div class={`homepage-shell mb-8 ${contentContainerClass}`}>
    <h1
      class="mb-4 text-4xl font-bold tracking-tight"
      style="color: var(--roads-text)"
    >
      {project.data.title}
    </h1>
    <div class="flex flex-wrap items-center gap-3">
      <StatusChip label={statusLabel} />
      <p
        class="text-xs font-medium uppercase tracking-wider"
        style="color: var(--roads-text-soft)"
      >
        Started <time>{timeline}</time>
        {homepage?.tag && <span> · {homepage.tag}</span>}
      </p>
    </div>
    {
      workingUrl ? (
        <p class="mt-6">
          <a
            href={workingUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-primary"
          >
            {ctaLabel} →
          </a>
        </p>
      ) : (
        <p class="mt-6 text-sm" style="color: var(--roads-text-soft)">
          No public website yet.
        </p>
      )
    }
  </div>

  <div class={contentContainerClass}>
    <Prose
      class={`mb-6 sm:mb-12 prose prose-lg prose-invert
      prose-headings:font-semibold prose-headings:text-slate-100
      prose-h2:text-2xl prose-h2:mt-10 prose-h2:mb-4
      prose-p:leading-relaxed prose-p:text-slate-300
      prose-a:text-accent prose-a:no-underline hover:prose-a:underline prose-a:font-medium`}
    >
      <Content />
    </Prose>
  </div>
</PageLayout>
