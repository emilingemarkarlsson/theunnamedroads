---
import Pagination from '@/components/Pagination.astro'
import PostsList from '@/components/PostsList.astro'
import PageLayout, {
  type Props as PageLayoutProps
} from '@/layouts/PageLayout.astro'
import config from '@/theme.config'
import { getPosts } from '@/util/posts'
import { NOINDEX_FOLLOW } from '@/util/seo'
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro'

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getPosts()

  return paginate(posts, { pageSize: config.postsPerPage })
}) satisfies GetStaticPaths

type Props = InferGetStaticPropsType<typeof getStaticPaths>

const { page } = Astro.props

const pageTitle =
  page.currentPage === 1
    ? 'Field Notes'
    : `Field Notes — Page ${page.currentPage}`

const frontmatter: PageLayoutProps['frontmatter'] = {
  title: pageTitle,
  description:
    'Dispatches from the road — Field Notes with receipts from building in public. Not manifestos; measured experiments and honest outcomes.',
  activeHeaderLink: 'Field Notes',
  prev: page.url.prev,
  next: page.url.next,
  ...(page.currentPage > 1 && {
    robotsContent: NOINDEX_FOLLOW,
    canonicalURL: new URL('/posts/', Astro.site).href
  })
}
---

<PageLayout {frontmatter}>
  {
    page.currentPage === 1 && (
      <div class="mb-8 space-y-3">
        <p class="section-eyebrow">Field Notes</p>
        <p class="text-base text-slate-300 sm:text-lg">
          Dispatches from the road — receipts from building in public, not
          manifestos. What broke, what it cost, what we learned walking terrain
          the map doesn't name.
        </p>
      </div>
    )
  }
  <h1>
    {frontmatter.title}
  </h1>
  <PostsList posts={page.data} />

  <Pagination slot="bottom" page={page} />
</PageLayout>
