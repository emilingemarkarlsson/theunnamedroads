---
import '@/style/main.css'
import ibmPlexNormal from '@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-400-normal.woff2?url'
import ibmPlexMedium from '@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-500-normal.woff2?url'
import ibmPlexSemiBold from '@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-600-normal.woff2?url'
import ibmPlexBold from '@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-700-normal.woff2?url'
import '@fontsource/ibm-plex-sans/latin.css'

import ModeManager from '@/components/mode/ModeManager.astro'
import CopyCodeButtonsPlugin from '@/plugins/CopyCodeButtonsPlugin.astro'
import MediumZoomPlugin from '@/plugins/MediumZoomPlugin.astro'
import GoogleTagManager from '@/components/GoogleTagManager.astro'
import GoogleTagManagerNoScript from '@/components/GoogleTagManagerNoScript.astro'
import config from '@/theme.config'
import { resolveImageUrl } from '@/util'
import type { HTMLAttributes } from 'astro/types'

const preloadFonts = [
  ibmPlexNormal,
  ibmPlexMedium,
  ibmPlexSemiBold,
  ibmPlexBold
]

export interface Props {
  frontmatter: Partial<{
    title: string
    author: string
    description: string
    canonicalURL: string
    openGraphImage: string | HTMLAttributes<'img'>
    publishedDate: Date
    /** When the page was last meaningfully updated (for freshness signals; AI/SEO) */
    dateModified?: Date
    /** Word count for Article schema (improves AI extractability) */
    wordCount?: number
    prev?: string
    next?: string
    /** Override meta robots (e.g. "noindex, follow" for 404 pages) */
    robotsContent?: string
    /** FAQ pairs for FAQPage schema (improves AI citation for Q&A content) */
    faq?: Array<{ question: string; answer: string }>
  }>
}

const {
  frontmatter: {
    title = config.title,
    author = config.author,
    description = config.description,
    canonicalURL = new URL(Astro.url.pathname, Astro.site).href,
    openGraphImage = config.openGraphImage || '/ogImage.png',
    publishedDate,
    dateModified,
    wordCount,
    prev,
    next,
    robotsContent,
    faq
  }
} = Astro.props

const robotsValue = robotsContent ?? 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'
const ogDescription = (description || config.description || '').trim() || config.description

let titleWithSuffix = title

if (String(title).toLowerCase() !== String(config.title).toLowerCase())
  titleWithSuffix += ` | ${config.title}`

const openGraphImageUrl = new URL(
  resolveImageUrl(openGraphImage) || '/ogImage.png',
  Astro.site
).href

const organizationId = `${config.site}#organization`
const websiteId = `${config.site}#website`
const webPageId = `${canonicalURL}#webpage`
const sameAsProfiles = ['https://x.com/unnamedroads']

const organizationJsonLd = {
  '@type': 'Organization',
  '@id': organizationId,
  name: config.title,
  description: config.description,
  url: config.site,
  logo: `${config.site}/favicon-tur.svg`,
  sameAs: sameAsProfiles,
  contactPoint: [
    {
      '@type': 'ContactPoint',
      contactType: 'Partnership inquiries',
      url: `${config.site}/contact`,
      availableLanguage: ['en'],
      areaServed: 'Global'
    }
  ]
}

const websiteJsonLd = {
  '@type': 'WebSite',
  '@id': websiteId,
  url: config.site,
  name: config.title,
  description: config.description,
  publisher: { '@id': organizationId },
  inLanguage: config.locale,
  potentialAction: {
    '@type': 'SearchAction',
    target: `${config.site}/search?q={search_term_string}`,
    'query-input': 'required name=search_term_string'
  }
}

const pathname = Astro.url.pathname
const isAgentsPage = pathname === '/agents' || pathname === '/agents/'

const webPageDateModified = dateModified?.toISOString() ?? publishedDate?.toISOString() ?? new Date().toISOString()

const webPageJsonLd = {
  '@type': isAgentsPage ? 'CollectionPage' : 'WebPage',
  '@id': webPageId,
  url: canonicalURL,
  name: titleWithSuffix,
  description,
  isPartOf: { '@id': websiteId },
  inLanguage: config.locale,
  datePublished: publishedDate?.toISOString(),
  dateModified: webPageDateModified,
  mainEntity: isAgentsPage
    ? {
        '@type': 'ItemList',
        name: 'AI Agent Team',
        description: 'AI agents that author content for The Unnamed Road—AION, NEXUS, FLUX, ECHO, FORGE, and CORE.',
        numberOfItems: 6
      }
    : { '@id': organizationId },
  author: {
    '@type': 'Organization',
    name: author
  }
}

// BreadcrumbList JSON-LD
const pathSegments = Astro.url.pathname.split('/').filter(Boolean)
const breadcrumbJsonLd = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: config.site
    },
    ...pathSegments.map((segment, index) => ({
      '@type': 'ListItem',
      position: index + 2,
      name: segment.charAt(0).toUpperCase() + segment.slice(1),
      item: `${config.site}/${pathSegments.slice(0, index + 1).join('/')}`
    }))
  ]
}

const articleDateModified = dateModified?.toISOString() ?? publishedDate?.toISOString() ?? new Date().toISOString()

const articleJsonLd =
  publishedDate && {
    '@type': 'Article',
    '@id': `${canonicalURL}#article`,
    headline: title,
    description,
    image: openGraphImageUrl,
    author: {
      '@type': 'Organization',
      name: author
    },
    publisher: { '@id': organizationId },
    datePublished: publishedDate.toISOString(),
    dateModified: articleDateModified,
    ...(wordCount != null && { wordCount: Number(wordCount) }),
    mainEntityOfPage: { '@id': webPageId },
    inLanguage: config.locale
  }

const faqJsonLd =
  faq?.length &&
  ({
    '@type': 'FAQPage',
    '@id': `${canonicalURL}#faq`,
    mainEntity: faq.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer
      }
    }))
  })

const jsonLdGraph: Record<string, unknown>[] = [
  organizationJsonLd,
  websiteJsonLd,
  webPageJsonLd,
  breadcrumbJsonLd
]
if (articleJsonLd) jsonLdGraph.push(articleJsonLd)
if (faqJsonLd) jsonLdGraph.push(faqJsonLd)
---

<!doctype html>
<html lang={config.locale} class={config.colorScheme || 'scheme-mono'}>
  <head>
    <GoogleTagManager />
    
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon-tur.svg" />
    <link rel="shortcut icon" href="/favicon-tur.svg" />
    <link rel="apple-touch-icon" href="/favicon-tur.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico?v=4" />
    <meta name="msapplication-TileColor" content="#000000" />
    <meta name="theme-color" content="#000000" />
    <link rel="manifest" href="/manifest.json" />

    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />
    {prev && <link rel="prev" href={new URL(prev, Astro.site).href} />}
    {next && <link rel="next" href={new URL(next, Astro.site).href} />}

    <title>{titleWithSuffix}</title>
    <meta name="title" content={titleWithSuffix} />
    <meta name="description" content={ogDescription} />
    <meta name="author" content={author} />
    <meta name="robots" content={robotsValue} />
    <meta name="googlebot" content={robotsValue} />
    <meta name="bingbot" content={robotsValue} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={title}
      href={new URL('feed.xml', Astro.site)}
    />

    <meta property="og:title" content={titleWithSuffix} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={openGraphImageUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={config.title} />
    <meta property="og:locale" content="en_US" />
    <meta property="article:author" content={config.author} />
    <meta property="article:publisher" content={config.title} />

    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={titleWithSuffix} />
    <meta property="twitter:description" content={ogDescription} />
    <meta property="twitter:image" content={openGraphImageUrl} />
    <meta property="twitter:creator" content="@theunnamedroad" />
    <meta property="twitter:site" content="@theunnamedroad" />

    {
      preloadFonts.map((font) => (
        <link
          rel="preload"
          as="font"
          type="font/woff2"
          href={font}
          crossorigin="anonymous"
        />
      ))
    }
    
    <!-- Preload critical resources -->
    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin />

    {
      publishedDate && (
        <meta
          property="article:published_time"
          content={publishedDate.toISOString()}
        />
      )
    }
    <ModeManager />
    <script
      is:inline
      defer
      src="https://umami.theunnamedroads.com/script.js"
      data-website-id="fc8f279b-0da8-4013-b8df-be07dc12a8f1"
    />
    <!-- PostHog Cloud EU (dual-run with Umami — filter by property site) -->
    <script is:inline>
      !(function (t, e) {
        var o, n, p, r;
        e.__SV ||
          ((window.posthog = e),
          (e._i = []),
          (e.init = function (i, s, a) {
            function g(t, e) {
              var o = e.split(".");
              2 == o.length && ((t = t[o[0]]), (e = o[1])),
                (t[e] = function () {
                  t.push([e].concat(Array.prototype.slice.call(arguments, 0)));
                });
            }
            ((p = t.createElement("script")).type = "text/javascript"),
              (p.crossOrigin = "anonymous"),
              (p.async = !0),
              (p.src =
                s.api_host.replace(".i.posthog.com", "-assets.i.posthog.com") +
                "/static/array.js"),
              (r = t.getElementsByTagName("script")[0]).parentNode.insertBefore(
                p,
                r
              );
            var u = e;
            for (
              void 0 !== a ? (u = e[a] = []) : (a = "posthog"),
                u.people = u.people || [],
                u.toString = function (t) {
                  var e = "posthog";
                  return (
                    "posthog" !== a && (e += "." + a), t || (e += " (stub)"), e
                  );
                },
                u.people.toString = function () {
                  return u.toString(1) + ".people (stub)";
                },
                o =
                  "init capture register register_once register_for_session unregister unregister_for_session getFeatureFlag getFeatureFlagPayload isFeatureEnabled reloadFeatureFlags updateEarlyAccessFeatureEnrollment getEarlyAccessFeatures on onFeatureFlags onSessionId getSurveys getActiveMatchingSurveys renderSurvey canRenderSurvey getNextSurveyStep identify setPersonProperties group resetGroups setPersonPropertiesForFlags resetPersonPropertiesForFlags setGroupPropertiesForFlags resetGroupPropertiesForFlags reset get_distinct_id set_config startSessionRecording stopSessionRecording sessionRecordingStarted captureException loadToolbar get_session_id createPersonProfile opt_in_capturing opt_out_capturing has_opted_in_capturing has_opted_out_capturing clear_opt_in_out_capturing debug".split(
                    " "
                  ),
                n = 0;
              n < o.length;
              n++
            )
              g(u, o[n]);
            e._i.push([i, s, a]);
          }),
          (e.__SV = 1));
      })(document, window.posthog || []);
      posthog.init("phc_qiJ9nCK5E9vGjWEPDx9KBBfxN2y8D3fbHTQyc5zcCf9n", {
        api_host: "https://e.theunnamedroads.com",
        ui_host: "https://eu.posthog.com",
        defaults: "2026-05-30",
        person_profiles: "identified_only",
        capture_pageview: true,
        capture_pageleave: true,
      });
      posthog.register({ site: "theunnamedroads" });
    </script>

    <!-- JSON-LD Structured Data -->
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@graph': jsonLdGraph
      })}
    ></script>
  </head>
  <body>
    <GoogleTagManagerNoScript />
    <slot />
    <CopyCodeButtonsPlugin />
    <MediumZoomPlugin />
  </body>
</html>
